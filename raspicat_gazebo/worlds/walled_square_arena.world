<?xml version="1.0"?>
<sdf version='1.6'>
  <world name='walled_square_arena'>
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
      </ode>
    </physics>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0 -25 8 0 0.35 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <model name='iscas_museum_outer_perimeter'>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <!-- Dimensions derived from the original ISCAS museum mesh bounding box -->
      <link name='north_wall'>
        <pose>0 8.0395 1.5 0 0 0</pose>
        <collision name='north_wall_collision'>
          <geometry>
            <box>
              <size>16.079 0.3 3.0</size>
            </box>
          </geometry>
        </collision>
        <visual name='north_wall_visual'>
          <geometry>
            <box>
              <size>16.079 0.3 3.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='south_wall'>
        <pose>0 -8.0395 1.5 0 0 0</pose>
        <collision name='south_wall_collision'>
          <geometry>
            <box>
              <size>16.079 0.3 3.0</size>
            </box>
          </geometry>
        </collision>
        <visual name='south_wall_visual'>
          <geometry>
            <box>
              <size>16.079 0.3 3.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='east_wall'>
        <pose>8.0395 0 1.5 0 0 0</pose>
        <collision name='east_wall_collision'>
          <geometry>
            <box>
              <size>0.3 16.079 3.0</size>
            </box>
          </geometry>
        </collision>
        <visual name='east_wall_visual'>
          <geometry>
            <box>
              <size>0.3 16.079 3.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='west_wall'>
        <pose>-8.0395 0 1.5 0 0 0</pose>
        <collision name='west_wall_collision'>
          <geometry>
            <box>
              <size>0.3 16.079 3.0</size>
            </box>
          </geometry>
        </collision>
        <visual name='west_wall_visual'>
          <geometry>
            <box>
              <size>0.3 16.079 3.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
