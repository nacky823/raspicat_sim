<?xml version="1.0"?>
<sdf version='1.6'>
  <world name='default'>
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://iscas_museum</uri>
    </include>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>80</iters>
          <!-- <iters>150</iters> --> <!-- CPU負荷大 -->
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
      </ode>
    </physics>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0 0 30 0 1.57 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <!-- ================================= 歩行者: ped2のみ ================================= -->
    <actor name="ped2">
      <pose>-5 4.5 0 0 0 1.190</pose>
      <skin><filename>model://walking_person/meshes/walk.dae</filename></skin>
      <animation name="walking">
        <filename>model://walking_person/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <!-- <script>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time>    <pose>3.5 5 0 0 0   1.75</pose></waypoint>
          <waypoint><time>4.0</time>  <pose>3.5 8 0 0 0   1.75</pose></waypoint>
          <waypoint><time>6.0</time>  <pose>3.5 8 0 0 0 -2.265</pose></waypoint>
          <waypoint><time>11.0</time> <pose> -1 5 0 0 0 -2.265</pose></waypoint>
          <waypoint><time>13.0</time> <pose> -1 5 0 0 0   1.75</pose></waypoint>
          <waypoint><time>17.0</time> <pose> -1 8 0 0 0   1.75</pose></waypoint>
          <waypoint><time>19.0</time> <pose> -1 8 0 0 0 -2.265</pose></waypoint>
          <waypoint><time>24.0</time> <pose> -5 5 0 0 0 -2.265</pose></waypoint>
          <waypoint><time>26.0</time> <pose> -5 5 0 0 0      0</pose></waypoint>
          <waypoint><time>32.0</time> <pose>3.5 5 0 0 0      0</pose></waypoint>
          <waypoint><time>35.0</time> <pose>3.5 5 0 0 0   1.75</pose></waypoint>
        </trajectory>
      </script> -->
      <script>
        <trajectory id="0" type="walking">
          <waypoint><time>0.000</time> <pose>-5 4.5 0 0 0 1.190</pose></waypoint>
          <waypoint><time>17.951</time> <pose>-3 9.5 0 0 0 1.190</pose></waypoint>
          <waypoint><time>35.901</time> <pose>-1 4.5 0 0 0 -1.190</pose></waypoint>
          <waypoint><time>53.852</time> <pose>1 9.5 0 0 0 1.190</pose></waypoint>
          <waypoint><time>71.802</time> <pose>3 4.5 0 0 0 -1.190</pose></waypoint>
          <waypoint><time>89.753</time> <pose>5 9.5 0 0 0 1.190</pose></waypoint>
          <waypoint><time>107.703</time> <pose>3 4.5 0 0 0 -1.951</pose></waypoint>
          <waypoint><time>125.654</time> <pose>1 9.5 0 0 0 1.951</pose></waypoint>
          <waypoint><time>143.604</time> <pose>-1 4.5 0 0 0 -1.951</pose></waypoint>
          <waypoint><time>161.555</time> <pose>-3 9.5 0 0 0 1.951</pose></waypoint>
          <waypoint><time>179.505</time> <pose>-5 4.5 0 0 0 -1.951</pose></waypoint>
        </trajectory>
      </script>
      <plugin name="ped2_proximity" filename="libpedestrian_proximity.so">
        <robot_model_name>raspicat</robot_model_name>
        <walk_speed>1.0</walk_speed>
        <stop_distance>1.4</stop_distance>
        <resume_distance>1.5</resume_distance>
      </plugin>
    </actor>

    <model name="ped2_collision">
      <pose>-5 4.5 0 0 0 1.190</pose>
      <static>false</static>
      <link name="body">
        <collision name="col">
          <pose>0 0 0 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius> <length>1.8</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius> <length>1.8</length></cylinder></geometry>
          <material>
            <ambient>0 0 0 0</ambient><diffuse>0 0 0 0</diffuse>
            <specular>0 0 0 0</specular><emissive>0 0 0 0</emissive>
            <transparency>1.0</transparency>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
      <plugin name="follow_ped2" filename="libfollow_actor.so">
        <actor_name>ped2</actor_name>
        <link_name>body</link_name>
        <z_offset>0.0</z_offset>
      </plugin>
    </model>

  </world>
</sdf>
